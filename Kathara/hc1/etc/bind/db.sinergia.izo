; Zona directa sinergia.izo: nombre -> IP (puntos 4b y 4c)
; Routers: un nombre por interfaz (rc0 = interfaz @0 de RC). Hosts: su nombre.

$TTL 300
@       IN  SOA  hc1.sinergia.izo. admin.sinergia.izo. (
                 2026111701 ; serial: subilo cada vez que cambies la zona
                 3600       ; refresh
                 600        ; retry
                 86400      ; expire
                 300 )      ; TTL negativo
        IN  NS   hc1.sinergia.izo.

; ===== Routers =====
; RA
ra0     IN  A    10.17.255.254   ; LA
ra1     IN  A    192.168.100.45  ; EA_K
; RB
rb0     IN  A    192.168.10.126  ; LB
rb1     IN  A    192.168.100.53  ; EB_K
; RC
rc0     IN  A    172.24.1.254    ; LC
